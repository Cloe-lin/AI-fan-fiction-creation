# ============================================================
# AI 同人文平台 - 环境配置
# ============================================================

LLM_API_KEY=your_deepseek_key
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_REVIEW_MODEL=deepseek-chat

RAG_ENABLED=true
RAG_TOP_K=5
RAG_NOVEL_SOURCE=../魔道祖师全文+番外by墨香铜臭（未修改版）.txt

# ---- Embedding：豆包（推荐）----
# 1. 打开 https://console.volcengine.com/ark
# 2. API Key 管理 → 创建 Key
# 3. 模型广场开通 Doubao-embedding-large，复制模型 ID 或创建接入点 ep-xxx
EMBEDDING_PROVIDER=doubao
EMBEDDING_API_KEY=你的火山方舟APIKey
EMBEDDING_MODEL=doubao-embedding-large-text-250515
EMBEDDING_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# 免费备选：本地 BGE
# EMBEDDING_PROVIDER=local_bge
# EMBEDDING_LOCAL_MODEL=BAAI/bge-large-zh-v1.5

# ---- 登录鉴权（JWT）----
# 生产环境务必更换；预置账号见 scripts/seed_users.py
JWT_SECRET=please_change_this_jwt_secret
# JWT_EXPIRE_HOURS=72
# AUTH_DB_PATH=app/data/auth.db

# ---- 兼容旧版管理员令牌（可选；优先使用 JWT 登录）----
ADMIN_TOKEN=please_change_this_admin_token
